@startuml fig6_2_etats_fichier
!include style.puml
skinparam StateBackgroundColor #EEF3FA
skinparam StateBorderColor #1F3A5F
skinparam StateFontColor #1F3A5F
skinparam StateStartColor #1F3A5F
skinparam StateEndColor #1F3A5F
