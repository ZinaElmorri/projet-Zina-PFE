left to right direction

state "Brouillon" as BRO
state "Non conforme" as NC
state "Soumis à validation" as SOU
state "Validé par le Manager" as VAL
state "Rejeté" as REJ

[*] --> BRO : Contrôle réussi\n(XSD conforme)
[*] --> NC : Contrôle\nnon conforme
BRO --> SOU : Soumission par l'Expert RH\n(aucune erreur métier)
SOU --> VAL : Validation par le Manager\n(quatre yeux)
SOU --> REJ : Rejet avec motif\n(quatre yeux)
REJ --> [*] : Nouveau contrôle\ndepuis la préparation
NC --> [*] : Nouveau contrôle\ndepuis la préparation
VAL --> [*]
@enduml
