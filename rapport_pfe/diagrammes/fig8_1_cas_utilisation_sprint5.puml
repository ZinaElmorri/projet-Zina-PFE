@startuml fig8_1_cas_utilisation_sprint5
!include style.puml
left to right direction

actor "Expert RH" as EXP
actor "Manager" as MGR
actor "Administrateur" as ADM
actor "Équipe technique" as TECH

rectangle "Sprint 5 : pilotage, déploiement et recette" {

  rectangle "Périmètre Pilotage" {
    usecase "Consulter le tableau de bord\nde son profil" as UC1
    usecase "Suivre les indicateurs KPI" as UC2
