  rectangle "Périmètre Supervision (Administrateur)" {
    usecase "Superviser les fichiers SEPA" as UC3a
    usecase "Superviser les sociétés débitrices" as UC3b
  }

  rectangle "Périmètre Déploiement et Recette" {
    usecase "Déployer la plateforme\npar conteneurs" as UC4
    usecase "Consulter la documentation\ninteractive de l'API" as UC5
    usecase "Dérouler la recette\nde bout en bout" as UC6
  }
}

EXP --> UC1
EXP --> UC2

MGR --> UC1
MGR --> UC2

ADM --> UC1
ADM --> UC2
ADM --> UC3a
ADM --> UC3b

TECH --> UC4
TECH --> UC5
TECH --> UC6
